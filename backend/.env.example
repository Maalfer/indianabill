APP_NAME="Indiana Bill Gijón"
DEBUG=false
CORS_ORIGINS=["https://indianabillgijon.es","http://localhost:5173"]

# Base de datos (SQLite por defecto, PostgreSQL para producción avanzada)
DATABASE_URL=sqlite:///./indianabill.db
# DATABASE_URL=postgresql://user:password@localhost/indianabill

# Seguridad JWT
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── EMAIL (elige una opción y configura) ──────────────────────────────────────
# Opción 1 — SendGrid (recomendado)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=hola@indianabillgijon.es
# EMAIL_FROM_NAME=Indiana Bill Gijón

# Opción 2 — SMTP (Gmail, Brevo, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hola@indianabillgijon.es
# SMTP_PASS=tu_contraseña_o_app_password

# ── WHATSAPP BUSINESS API (elige una opción) ──────────────────────────────────
# Opción 1 — Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WA_NUMBER=whatsapp:+14155238886

# Opción 2 — Meta Cloud API (oficial, más barato a escala)
# WA_PHONE_NUMBER_ID=123456789012345
# WA_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WA_VERIFY_TOKEN=token_secreto_para_verificar_webhook

# Número del equipo que recibe alertas de nuevos leads
WA_STAFF_NUMBER=+34684657760

# ── STRIPE (pagos online) ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=tu_clave_secreta_de_stripe
# STRIPE_PUBLISHABLE_KEY=tu_clave_publica_de_stripe
# STRIPE_WEBHOOK_SECRET=tu_secreto_de_webhook_stripe

# ── ANALYTICS ─────────────────────────────────────────────────────────────────
# Añadir también en frontend/index.html (ver comentarios en ese archivo)
# VITE_GA4_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=XXXXXXXXXXXXXXX
